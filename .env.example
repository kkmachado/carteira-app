PLUGGY_CLIENT_ID=seu_client_id
PLUGGY_CLIENT_SECRET=seu_client_secret
PLUGGY_ITEM_ID=seu_item_id
PORT=
# Porta publicada no host (Docker). Padrão 3000; no homelab a 3000 é do Easypanel
HOST_PORT=3000

# Gastos: titular de cada cartão pelo final (a Pluggy não traz o nome) e ids de
# contas a deixar fora da análise (ex.: cartão parado), separados por vírgula
CARD_HOLDERS=1234:Fulano,5678:Beltrana
GASTOS_IGNORAR_CONTAS=
